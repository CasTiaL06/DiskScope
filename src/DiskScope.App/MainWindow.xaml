<Window x:Class="DiskScope.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DiskScope.App.Localization"
        xmlns:views="clr-namespace:DiskScope.App.Views"
        Title="{loc:Tr Key=AppTitle}"
        Icon="pack://application:,,,/Assets/DiskScope.ico"
        Width="1360"
        Height="820"
        MinWidth="1120"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Surface0Brush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{StaticResource Surface1Brush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Orientation="Horizontal" Margin="20,24,20,20">
                    <Image Source="pack://application:,,,/Assets/logo.png"
                           Width="32" Height="32"
                           RenderOptions.BitmapScalingMode="HighQuality" />

                    <TextBlock Text="DiskScope"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0" />
                </StackPanel>

                <!-- Navigation -->
                <StackPanel Grid.Row="1" Margin="12,4,12,0">
                    <RadioButton x:Name="NavOverview"
                                 GroupName="Nav"
                                 Style="{StaticResource NavButton}"
                                 Tag="&#xE80F;"
                                 Content="{loc:Tr Key=NavigationOverview}"
                                 Checked="Nav_Checked" />

                    <RadioButton x:Name="NavAnalyzer"
                                 GroupName="Nav"
                                 Style="{StaticResource NavButton}"
                                 Tag="&#xE721;"
                                 Content="{loc:Tr Key=NavigationAnalyzer}"
                                 Checked="Nav_Checked" />
                </StackPanel>

                <!-- Language -->
                <Button Grid.Row="2"
                        Style="{StaticResource SecondaryButton}"
                        Content="TR / EN"
                        Padding="14,8"
                        Margin="16,0,16,20"
                        Click="LanguageToggle_Click" />
            </Grid>
        </Border>

        <!-- Pages -->
        <Grid Grid.Column="1">
            <Grid.Background>
                <RadialGradientBrush Center="0.9,0" GradientOrigin="0.9,0" RadiusX="0.9" RadiusY="0.75">
                    <GradientStop Color="#1C2BB3C0" Offset="0" />
                    <GradientStop Color="#002BB3C0" Offset="1" />
                </RadialGradientBrush>
            </Grid.Background>

            <views:OverviewView x:Name="Overview" />
            <views:AnalyzerView x:Name="Analyzer" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
