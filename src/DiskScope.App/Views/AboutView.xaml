<UserControl x:Class="DiskScope.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DiskScope.App.Localization">

    <Grid>
        <Border Style="{StaticResource CardStyle}"
                Padding="40"
                MaxWidth="560"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center">
                <Image Source="pack://application:,,,/Assets/logo.png"
                       Width="120" Height="120"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <TextBlock HorizontalAlignment="Center"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="36" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,18,0,0">
                    <Run Text="Nex" /><Run Text="Disk" Foreground="{StaticResource AccentCyanBrush}" />
                </TextBlock>

                <TextBlock Text="{loc:Tr Key=BrandTagline}"
                           Style="{StaticResource BodyText}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,6,0,0" />

                <TextBlock x:Name="VersionText"
                           Style="{StaticResource CaptionText}"
                           HorizontalAlignment="Center" Margin="0,18,0,0" />

                <TextBlock Text="{loc:Tr Key=AboutLicense}"
                           Style="{StaticResource CaptionText}"
                           HorizontalAlignment="Center" Margin="0,4,0,0" />

                <Button Style="{StaticResource PrimaryButton}"
                        Content="{loc:Tr Key=AboutGitHub}"
                        HorizontalAlignment="Center"
                        Margin="0,24,0,0"
                        Click="GitHub_Click" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
