<UserControl x:Class="DiskScope.App.Views.AnalyzerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DiskScope.App.Localization"
             xmlns:ctl="clr-namespace:DiskScope.App.Controls">

    <UserControl.Resources>
        <ContextMenu x:Key="NodeMenu">
            <MenuItem Header="{loc:Tr Key=ContextOpenFolder}" Click="MenuOpenFolder_Click" />
            <MenuItem Header="{loc:Tr Key=ContextOpenExplorer}" Click="MenuOpenExplorer_Click" />
            <MenuItem Header="{loc:Tr Key=ContextCopyPath}" Click="MenuCopyPath_Click" />
        </ContextMenu>

        <DataTemplate x:Key="StatRowTemplate">
            <Grid Margin="0,0,0,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="54" />
                </Grid.ColumnDefinitions>

                <Border Width="10" Height="10" CornerRadius="3"
                        Background="{Binding Brush}"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0" />

                <TextBlock Grid.Column="1"
                           Text="{Binding Name}"
                           Style="{StaticResource BodyText}"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Column="2"
                           Text="{Binding SizeText}"
                           Style="{StaticResource BodyText}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="8,0,0,0" />

                <TextBlock Grid.Column="3"
                           Text="{Binding PercentText}"
                           Style="{StaticResource CaptionText}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Margin="24,20,24,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="UpButton"
                    Style="{StaticResource IconButton}"
                    Content="&#xE74A;"
                    ToolTip="{loc:Tr Key=ToolUp}"
                    Click="UpButton_Click"
                    Margin="0,0,8,0" />

            <ScrollViewer Grid.Column="1"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled"
                          VerticalAlignment="Center">
                <ItemsControl x:Name="BreadcrumbList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource GhostButton}"
                                        Content="{Binding Text}"
                                        Foreground="{Binding TextBrush}"
                                        FontWeight="{Binding Weight}"
                                        Padding="8,5"
                                        Click="Crumb_Click" />
                                <TextBlock Text="&#x203A;"
                                           Foreground="{StaticResource TextDisabledBrush}"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding SeparatorVisibility}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
                <Button x:Name="RescanButton"
                        Style="{StaticResource IconButton}"
                        Content="&#xE72C;"
                        ToolTip="{loc:Tr Key=ToolRescan}"
                        Click="RescanButton_Click"
                        Margin="0,0,8,0" />

                <Button x:Name="PickFolderButton"
                        Style="{StaticResource SecondaryButton}"
                        Content="{loc:Tr Key=ToolPickFolder}"
                        Padding="14,8"
                        Click="PickFolderButton_Click" />
            </StackPanel>
        </Grid>

        <!-- Content (three mutually exclusive states) -->
        <Grid Grid.Row="1" Margin="24,0,24,0">

            <!-- Empty state -->
            <StackPanel x:Name="EmptyPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="420">
                <Border Width="64" Height="64" CornerRadius="16"
                        Background="{StaticResource Surface2Brush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Center">
                    <TextBlock Text="&#xEDA2;"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="26"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <TextBlock Text="{loc:Tr Key=EmptyTitle}"
                           Style="{StaticResource TitleText}"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,0" />

                <TextBlock x:Name="EmptyBodyText"
                           Style="{StaticResource BodyText}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,8,0,0" />

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,22,0,0">
                    <Button Style="{StaticResource PrimaryButton}"
                            Content="{loc:Tr Key=ActionChooseDisk}"
                            Click="ChooseDisk_Click"
                            Margin="0,0,8,0" />
                    <Button Style="{StaticResource SecondaryButton}"
                            Content="{loc:Tr Key=ToolPickFolder}"
                            Click="PickFolderButton_Click" />
                </StackPanel>
            </StackPanel>

            <!-- Scanning state -->
            <StackPanel x:Name="ScanningPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="520"
                        Visibility="Collapsed">
                <TextBlock x:Name="ScanPercentText"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="56"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center" />

                <TextBlock Text="{loc:Tr Key=ScanningTitle}"
                           Style="{StaticResource SubtitleText}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0" />

                <TextBlock x:Name="ScanPathText"
                           Style="{StaticResource CaptionText}"
                           TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0" />
            </StackPanel>

            <!-- Result state -->
            <Grid x:Name="ResultGrid" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>

                <!-- Folder list -->
                <Border Style="{StaticResource CardStyle}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="ListInfoText"
                                   Style="{StaticResource CaptionText}"
                                   Margin="16,14,16,8" />

                        <Grid Grid.Row="1" Margin="18,0,18,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="74" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="1" Text="{loc:Tr Key=ColumnName}" Style="{StaticResource CaptionText}" />
                            <TextBlock Grid.Column="2" Text="{loc:Tr Key=ColumnSize}" Style="{StaticResource CaptionText}"
                                       HorizontalAlignment="Right" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="3" Text="{loc:Tr Key=ColumnShare}" Style="{StaticResource CaptionText}" />
                        </Grid>

                        <ListBox x:Name="FolderList"
                                 Grid.Row="2"
                                 Style="{StaticResource PlainListBox}"
                                 SelectionChanged="FolderList_SelectionChanged"
                                 KeyDown="FolderList_KeyDown">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource RowItemStyle}">
                                    <Setter Property="ContextMenu" Value="{StaticResource NodeMenu}" />
                                    <EventSetter Event="MouseDoubleClick" Handler="Row_DoubleClick" />
                                    <EventSetter Event="ContextMenuOpening" Handler="Row_ContextMenuOpening" />
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="74" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding Glyph}"
                                                   FontFamily="{StaticResource IconFont}"
                                                   FontSize="14"
                                                   Foreground="{Binding IconBrush}"
                                                   VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   ToolTip="{Binding Name}"
                                                   Style="{StaticResource BodyText}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding SizeText}"
                                                   Style="{StaticResource BodyText}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0" />

                                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PercentText}"
                                                       Style="{StaticResource CaptionText}"
                                                       Margin="0,0,0,3" />
                                            <ProgressBar Value="{Binding PercentValue, Mode=OneWay}"
                                                         Maximum="100"
                                                         Height="4"
                                                         Style="{StaticResource ThinProgress}"
                                                         Foreground="{Binding BarBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Treemap -->
                <Border Grid.Column="2"
                        Style="{StaticResource CardStyle}"
                        Padding="6">
                    <ctl:TreemapControl x:Name="Treemap"
                                        ContextMenu="{StaticResource NodeMenu}"
                                        ContextMenuOpening="Treemap_ContextMenuOpening" />
                </Border>

                <!-- Right panel -->
                <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- Summary -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr Key=PanelSummary}" Style="{StaticResource SubtitleText}" />

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock Text="{loc:Tr Key=SummarySize}" Style="{StaticResource CaptionText}" />
                                        <TextBlock x:Name="SumSizeValue" Style="{StaticResource TitleText}" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="0,0,0,14">
                                        <TextBlock Text="{loc:Tr Key=SummaryTime}" Style="{StaticResource CaptionText}" />
                                        <TextBlock x:Name="SumTimeValue" Style="{StaticResource TitleText}" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1">
                                        <TextBlock Text="{loc:Tr Key=SummaryFiles}" Style="{StaticResource CaptionText}" />
                                        <TextBlock x:Name="SumFilesValue" Style="{StaticResource TitleText}" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="1">
                                        <TextBlock Text="{loc:Tr Key=SummaryFolders}" Style="{StaticResource CaptionText}" />
                                        <TextBlock x:Name="SumFoldersValue" Style="{StaticResource TitleText}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- File types -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr Key=PanelFileTypes}" Style="{StaticResource SubtitleText}" />

                                <Grid x:Name="TypeBar" Height="8" Margin="0,14,0,14" />

                                <ItemsControl x:Name="TypeList"
                                              ItemTemplate="{StaticResource StatRowTemplate}" />
                            </StackPanel>
                        </Border>

                        <!-- Extensions -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr Key=PanelExtensions}" Style="{StaticResource SubtitleText}" />

                                <ItemsControl x:Name="ExtList"
                                              Margin="0,14,0,0"
                                              ItemTemplate="{StaticResource StatRowTemplate}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border x:Name="StatusPanel"
                Grid.Row="2"
                Margin="24,12,24,18"
                Padding="16,10"
                CornerRadius="10"
                Background="{StaticResource Surface1Brush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                Visibility="Collapsed">
            <DockPanel LastChildFill="True">
                <Button x:Name="CancelButton"
                        DockPanel.Dock="Right"
                        Style="{StaticResource SecondaryButton}"
                        Content="{loc:Tr Key=CommonCancel}"
                        Padding="14,6"
                        Click="CancelButton_Click" />

                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StatusText"
                               Style="{StaticResource BodyText}"
                               MaxWidth="360"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0" />

                    <ProgressBar x:Name="ScanProgressBar"
                                 Style="{StaticResource ThinProgress}"
                                 Width="180"
                                 Maximum="100"
                                 Margin="0,0,18,0" />

                    <TextBlock x:Name="ElapsedText" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,18,0" />
                    <TextBlock x:Name="FilesText" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,18,0" />
                    <TextBlock x:Name="FoldersText" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,18,0" />
                    <TextBlock x:Name="SizeText" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,18,0" />

                    <TextBlock x:Name="SkippedText"
                               Style="{StaticResource CaptionText}"
                               Foreground="{StaticResource WarningBrush}"
                               Cursor="Hand"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"
                               MouseLeftButtonUp="SkippedText_Click" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
