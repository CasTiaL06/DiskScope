<UserControl x:Class="DiskScope.App.Views.HealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DiskScope.App.Localization">

    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="{loc:Tr Key=NavigationHealth}" Style="{StaticResource DisplayText}" />
                <TextBlock Text="{loc:Tr Key=HealthPageDesc}"
                           Style="{StaticResource BodyText}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,6,0,0" />
            </StackPanel>

            <Button x:Name="RefreshButton"
                    Grid.Column="1"
                    Style="{StaticResource SecondaryButton}"
                    Content="{loc:Tr Key=CommonRefresh}"
                    VerticalAlignment="Center"
                    Click="RefreshButton_Click" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <ItemsControl x:Name="HealthList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}" Width="380" Padding="22" Margin="0,0,16,16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="56" Height="56" CornerRadius="28"
                                                Background="{Binding StatusBackground}" Margin="0,0,16,0">
                                            <TextBlock Text="{Binding Glyph}"
                                                       FontFamily="{StaticResource IconFont}" FontSize="24"
                                                       Foreground="{Binding StatusBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusText}"
                                                       FontFamily="Segoe UI Variable Display, Segoe UI"
                                                       FontSize="22" FontWeight="SemiBold"
                                                       Foreground="{Binding StatusBrush}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}"
                                                           MaxWidth="190" TextTrimming="CharacterEllipsis" />
                                                <Border Background="{StaticResource Surface3Brush}"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding MediaText}" Style="{StaticResource CaptionText}" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>

                                    <Grid Margin="0,20,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="{loc:Tr Key=HealthTemperature}" Style="{StaticResource CaptionText}" />
                                            <TextBlock Text="{Binding TemperatureText}" Style="{StaticResource BodyText}"
                                                       FontWeight="SemiBold" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{loc:Tr Key=HealthPowerOn}" Style="{StaticResource CaptionText}" />
                                            <TextBlock Text="{Binding HoursText}" Style="{StaticResource BodyText}"
                                                       FontWeight="SemiBold" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{loc:Tr Key=ColumnSize}" Style="{StaticResource CaptionText}" />
                                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource BodyText}"
                                                       FontWeight="SemiBold" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="EmptyText"
                           Text="{loc:Tr Key=HealthEmpty}"
                           Style="{StaticResource BodyText}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           MaxWidth="520"
                           HorizontalAlignment="Left"
                           Visibility="Collapsed" />
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
