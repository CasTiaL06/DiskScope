<UserControl x:Class="DiskScope.App.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DiskScope.App.Localization">

    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="{loc:Tr Key=NavigationOverview}"
                           Style="{StaticResource DisplayText}" />

                <TextBlock x:Name="SummaryText"
                           Style="{StaticResource BodyText}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,6,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <Button x:Name="RefreshButton"
                        Style="{StaticResource SecondaryButton}"
                        Content="{loc:Tr Key=CommonRefresh}"
                        Click="RefreshButton_Click"
                        Margin="0,0,8,0" />

                <Button Style="{StaticResource PrimaryButton}"
                        Content="{loc:Tr Key=ActionAnalyzeFolder}"
                        Click="PickFolder_Click" />
            </StackPanel>
        </Grid>

        <!-- Disk cards -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <ItemsControl x:Name="DrivesList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}"
                                    Width="360"
                                    Padding="20"
                                    Margin="0,0,16,16">
                                <StackPanel>

                                    <!-- Title row -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="40" Height="40"
                                                CornerRadius="10"
                                                Background="{StaticResource Surface3Brush}"
                                                Margin="0,0,12,0">
                                            <TextBlock Text="&#xEDA2;"
                                                       FontFamily="{StaticResource IconFont}"
                                                       FontSize="18"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       Style="{StaticResource SubtitleText}"
                                                       TextTrimming="CharacterEllipsis" />

                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding DriveLetter}"
                                                           Style="{StaticResource CaptionText}"
                                                           VerticalAlignment="Center" />

                                                <Border Background="{StaticResource Surface3Brush}"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="6,1"
                                                        Margin="8,0,0,0">
                                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock"
                                                                   BasedOn="{StaticResource CaptionText}">
                                                                <Setter Property="Text" Value="{loc:Tr Key=DiskMediaUnknown}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding MediaType}" Value="Ssd">
                                                                        <Setter Property="Text" Value="{loc:Tr Key=DiskMediaSsd}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding MediaType}" Value="Hdd">
                                                                        <Setter Property="Text" Value="{loc:Tr Key=DiskMediaHdd}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding MediaType}" Value="Nvme">
                                                                        <Setter Property="Text" Value="{loc:Tr Key=DiskMediaNvme}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>

                                                <TextBlock Text="{Binding FileSystem}"
                                                           Style="{StaticResource CaptionText}"
                                                           Margin="8,0,0,0"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding UsagePercentage, Mode=OneWay, StringFormat={}{0:0}%}"
                                                   Style="{StaticResource TitleText}"
                                                   VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Usage bar -->
                                    <ProgressBar Value="{Binding UsagePercentage, Mode=OneWay}"
                                                 Maximum="100"
                                                 Margin="0,18,0,14">
                                        <ProgressBar.Style>
                                            <Style TargetType="ProgressBar"
                                                   BasedOn="{StaticResource ThinProgress}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsCritical}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ProgressBar.Style>
                                    </ProgressBar>

                                    <!-- Numbers -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="{loc:Tr Key=DiskUsedShort}" Style="{StaticResource CaptionText}" />
                                            <TextBlock Text="{Binding UsedSpaceFormatted}"
                                                       Style="{StaticResource BodyText}"
                                                       FontWeight="SemiBold" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{loc:Tr Key=DiskFreeShort}" Style="{StaticResource CaptionText}" />
                                            <TextBlock Text="{Binding AvailableFreeSpaceFormatted}"
                                                       Style="{StaticResource BodyText}"
                                                       FontWeight="SemiBold" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{loc:Tr Key=DiskTotalShort}" Style="{StaticResource CaptionText}" />
                                            <TextBlock Text="{Binding TotalSizeFormatted}"
                                                       Style="{StaticResource BodyText}"
                                                       FontWeight="SemiBold" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>

                                    <Button Style="{StaticResource SecondaryButton}"
                                            Content="{loc:Tr Key=ActionAnalyze}"
                                            Click="AnalyzeButton_Click"
                                            Padding="16,8"
                                            Margin="0,18,0,0"
                                            HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="EmptyText"
                           Text="{loc:Tr Key=OverviewEmpty}"
                           Style="{StaticResource BodyText}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Visibility="Collapsed" />
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
